# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Blockchain (Hyperledger Besu)
BESU_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x_your_deployed_contract_address
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key

# AES-256 key for encrypting QR payloads (64 hex chars = 32 bytes)
AES_SECRET_KEY=generate_a_random_64_char_hex_string

# Auth
JWT_SECRET=generate_a_long_random_string

# Email (used to send ticket QR codes to students)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
